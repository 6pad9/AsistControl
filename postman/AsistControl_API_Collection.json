								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"codigo\": \"EMP001\",\n    \"nombres\": \"Duplicate\",\n    \"apellidos\": \"Employee\",\n    \"numeroDocumento\": \"99999999\",\n    \"sedeId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/empleados",
							"host": [
